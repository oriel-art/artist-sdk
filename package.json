{
  "name": "@oriel-art/artist-sdk",
  "version": "0.1.0-alpha.4",
  "description": "Experimental, dependency-free utilities for JavaScript generative art",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/oriel-art/artist-sdk.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.js",
    "./random": "./src/random.js",
    "./parameters": "./src/parameters.js",
    "./webgl": "./src/webgl.js",
    "./bridge": "./src/bridge.js",
    "./browser": "./src/browser.js",
    "./info": "./src/info.js",
    "./testing": "./src/testing.js",
    "./parameter-panel": "./src/parameter-panel.js"
  },
  "files": [
    "src",
    "examples",
    "scripts",
    "docs",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/core.test.mjs tests/testing.test.mjs tests/recipes.test.mjs",
    "test:browser": "node --test tests/browser.test.mjs",
    "size": "node scripts/size.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1"
  }
}
