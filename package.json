{
  "name": "@oriel-art/artist-sdk",
  "version": "0.1.0-alpha.4",
  "description": "Experimental, dependency-free utilities for JavaScript generative art",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/oriel-art/artist-sdk.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.js",
    "./random": "./src/random.js",
    "./parameters": "./src/parameters.js",
    "./webgl": "./src/webgl.js",
    "./bridge": "./src/bridge.js",
    "./browser": "./src/browser.js",
    "./info": "./src/info.js",
    "./testing": "./src/testing.js",
    "./parameter-panel": "./src/parameter-panel.js",
    "./capabilities": {
      "types": "./src/capabilities.d.ts",
      "import": "./src/capabilities.js",
      "default": "./src/capabilities.js"
    },
    "./metadata": {
      "types": "./src/metadata.d.ts",
      "import": "./src/metadata.js",
      "default": "./src/metadata.js"
    },
    "./discovery": {
      "types": "./src/discovery.d.ts",
      "import": "./src/discovery.js",
      "default": "./src/discovery.js"
    },
    "./renderers": {
      "types": "./src/renderers.d.ts",
      "import": "./src/renderers.js",
      "default": "./src/renderers.js"
    }
  },
  "files": [
    "src",
    "examples",
    "scripts",
    "docs",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/core.test.mjs tests/testing.test.mjs tests/recipes.test.mjs tests/descriptions.test.mjs tests/capability-workflows.test.mjs tests/print-workflow.test.mjs tests/renderers.test.mjs",
    "test:browser": "npm run build:renderer-examples && node --test tests/browser.test.mjs tests/renderers-browser.test.mjs",
    "size": "node scripts/size.mjs",
    "build": "node scripts/build-packages.mjs",
    "prepare": "npm run build",
    "test:types": "tsc -p tests/types/tsconfig.json",
    "test:packages": "node scripts/test-packages.mjs",
    "build:renderer-examples": "node scripts/build-renderer-examples.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "p5": "1.11.11",
    "playwright": "^1.64.1",
    "three": "0.167.0",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "packages/*"
  ]
}
